# Required for Google Gemini (default LLM provider)
# Get your API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Required for data fetching (stock data, fundamentals, news)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Optional: Only needed if using Vertex AI as llm_provider
# Vertex AI uses Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_REGION=us-central1

# Optional: Only needed if using Ollama as llm_provider
# OLLAMA_API_KEY=your_ollama_api_key_here

# Optional: Only needed if using OpenAI as llm_provider or embedding_provider
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Only needed if using Anthropic as llm_provider
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
