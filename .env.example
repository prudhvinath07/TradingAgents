# Required for data fetching (stock data, fundamentals, news)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Required for Ollama Cloud (default) - Get your key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here

# Optional: Only needed if using Google as llm_provider
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: Only needed if using OpenAI as llm_provider or embedding_provider
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Only needed if using Anthropic as llm_provider
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
